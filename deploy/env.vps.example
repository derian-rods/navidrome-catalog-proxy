PORT=4540
HOST=0.0.0.0
LOG_LEVEL=info

NAVIDROME_URL=http://navidrome:4533

MUSIC_DIR=/music
DOWNLOAD_DIR=/app/downloads
CACHE_DIR=/app/cache
DATA_DIR=/app/data

YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

AUDIO_FORMAT=opus
OPUS_BITRATE=128k
PREFER_ORIGINAL_OPUS=true

YOUTUBE_MAX_RESULTS=10
YOUTUBE_MAX_REMOTE_SONGS=6
YOUTUBE_MAX_SONG_DURATION_SECONDS=600
DOWNLOAD_CONCURRENCY=1

ACOUSTID_API_KEY=

CLEANUP_ENABLED=false
CLEANUP_DRY_RUN=true
CLEANUP_INTERVAL_HOURS=168
CLEANUP_QUARANTINE_DIR=/music/.trash-candidates
CLEANUP_MAX_PLAY_COUNT=1
CLEANUP_NOT_PLAYED_DAYS=30
CLEANUP_MIN_LIBRARY_AGE_DAYS=45
CLEANUP_QUARANTINE_DAYS=30
