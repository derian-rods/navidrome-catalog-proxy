PORT=4540
HOST=127.0.0.1
LOG_LEVEL=info
CATALOG_ADMIN_PASSWORD=

NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=

MUSIC_DIR=/opt/navidrome/music
DOWNLOAD_DIR=/opt/navidrome-catalog-proxy/downloads
CACHE_DIR=/opt/navidrome-catalog-proxy/cache
DATA_DIR=/opt/navidrome-catalog-proxy/data
XDG_CACHE_HOME=/opt/navidrome-catalog-proxy/cache

YTDLP_PATH=yt-dlp
YTDLP_COOKIES_FILE=
YTDLP_JS_RUNTIME=node:/usr/local/bin/node
YTDLP_REMOTE_COMPONENTS=ejs:github
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

AUDIO_FORMAT=opus
OPUS_BITRATE=128k
PREFER_ORIGINAL_OPUS=true

YOUTUBE_MAX_RESULTS=25
YOUTUBE_MAX_REMOTE_SONGS=15
YOUTUBE_MAX_PLAYLIST_RESULTS=20
YOUTUBE_MAX_SONG_DURATION_SECONDS=600
DOWNLOAD_CONCURRENCY=1

ACOUSTID_API_KEY=

CLEANUP_ENABLED=false
CLEANUP_DRY_RUN=true
CLEANUP_INTERVAL_HOURS=168
CLEANUP_QUARANTINE_DIR=/opt/navidrome/music/.trash-candidates
CLEANUP_MAX_PLAY_COUNT=1
CLEANUP_NOT_PLAYED_DAYS=30
CLEANUP_MIN_LIBRARY_AGE_DAYS=45
CLEANUP_QUARANTINE_DAYS=30
