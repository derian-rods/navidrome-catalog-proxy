PORT=4540
HOST=127.0.0.1
LOG_LEVEL=info

NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=

MUSIC_DIR=/opt/navidrome/music
DOWNLOAD_DIR=/opt/navidrome-catalog-proxy/downloads
CACHE_DIR=/opt/navidrome-catalog-proxy/cache
DATA_DIR=/opt/navidrome-catalog-proxy/data

YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

AUDIO_FORMAT=opus
OPUS_BITRATE=128k
PREFER_ORIGINAL_OPUS=true

YOUTUBE_MAX_RESULTS=10
DOWNLOAD_CONCURRENCY=1

ACOUSTID_API_KEY=

CLEANUP_ENABLED=false
CLEANUP_DRY_RUN=true
CLEANUP_MAX_PLAY_COUNT=1
CLEANUP_NOT_PLAYED_DAYS=30
CLEANUP_MIN_LIBRARY_AGE_DAYS=45
CLEANUP_QUARANTINE_DAYS=30
